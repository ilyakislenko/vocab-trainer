{
  "openapi": "3.1.0",
  "info": {
    "title": "Vocab Trainer API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/decks": {
      "get": {
        "tags": ["decks"],
        "summary": "List Decks",
        "operationId": "list_decks_decks_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeckOut"
                  },
                  "type": "array",
                  "title": "Response List Decks Decks Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["decks"],
        "summary": "Create Deck",
        "operationId": "create_deck_decks_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDeckIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeckOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/decks/{deck_id}/import": {
      "post": {
        "tags": ["decks"],
        "summary": "Import Words",
        "operationId": "import_words_decks__deck_id__import_post",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Deck Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/review/queue": {
      "get": {
        "tags": ["review"],
        "summary": "Review Queue",
        "operationId": "review_queue_review_queue_get",
        "parameters": [
          {
            "name": "deck_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Deck Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CardOut"
                  },
                  "title": "Response Review Queue Review Queue Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/review": {
      "post": {
        "tags": ["review"],
        "summary": "Record Review",
        "operationId": "record_review_review_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": ["stats"],
        "summary": "Stats",
        "operationId": "stats_stats_get",
        "parameters": [
          {
            "name": "deck_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Deck Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/practice/check": {
      "post": {
        "tags": ["practice"],
        "summary": "Check Sentence",
        "operationId": "check_sentence_practice_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckSentenceIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/practice/example": {
      "get": {
        "tags": ["practice"],
        "summary": "Practice Example",
        "operationId": "practice_example_practice_example_get",
        "parameters": [
          {
            "name": "card_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Card Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CardOut": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "word": {
            "type": "string",
            "title": "Word"
          },
          "translation": {
            "type": "string",
            "title": "Translation"
          },
          "transcription": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcription"
          }
        },
        "type": "object",
        "required": ["id", "word", "translation", "transcription"],
        "title": "CardOut"
      },
      "CheckSentenceIn": {
        "properties": {
          "card_id": {
            "type": "integer",
            "title": "Card Id"
          },
          "sentence": {
            "type": "string",
            "title": "Sentence"
          }
        },
        "type": "object",
        "required": ["card_id", "sentence"],
        "title": "CheckSentenceIn"
      },
      "CreateDeckIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": ["name"],
        "title": "CreateDeckIn"
      },
      "DeckOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": ["id", "name"],
        "title": "DeckOut"
      },
      "ExampleOut": {
        "properties": {
          "example": {
            "type": "string",
            "title": "Example"
          }
        },
        "type": "object",
        "required": ["example"],
        "title": "ExampleOut"
      },
      "FeedbackOut": {
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback"
          },
          "corrected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrected"
          },
          "example": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Example"
          }
        },
        "type": "object",
        "required": ["verdict", "feedback", "corrected", "example"],
        "title": "FeedbackOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportIn": {
        "properties": {
          "raw": {
            "type": "string",
            "title": "Raw"
          },
          "format": {
            "type": "string",
            "enum": ["csv", "markdown"],
            "title": "Format"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": true
          }
        },
        "type": "object",
        "required": ["raw", "format"],
        "title": "ImportIn"
      },
      "ImportOut": {
        "properties": {
          "committed": {
            "type": "boolean",
            "title": "Committed"
          },
          "imported": {
            "items": {
              "$ref": "#/components/schemas/CardOut"
            },
            "type": "array",
            "title": "Imported"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/RowErrorOut"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": ["committed", "imported", "errors"],
        "title": "ImportOut"
      },
      "ReviewIn": {
        "properties": {
          "card_id": {
            "type": "integer",
            "title": "Card Id"
          },
          "rating": {
            "type": "integer",
            "enum": [1, 2, 3, 4],
            "title": "Rating"
          }
        },
        "type": "object",
        "required": ["card_id", "rating"],
        "title": "ReviewIn"
      },
      "RowErrorOut": {
        "properties": {
          "line": {
            "type": "integer",
            "title": "Line"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["line", "reason"],
        "title": "RowErrorOut"
      },
      "StatsOut": {
        "properties": {
          "due_today": {
            "type": "integer",
            "title": "Due Today"
          },
          "total_reviews": {
            "type": "integer",
            "title": "Total Reviews"
          }
        },
        "type": "object",
        "required": ["due_today", "total_reviews"],
        "title": "StatsOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "Verdict": {
        "type": "string",
        "enum": ["ok", "needs_work"],
        "title": "Verdict"
      }
    }
  }
}
